# --- Database --------------------------------------------------------------
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/rice_management?schema=public"
DIRECT_DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/rice_management?schema=public"
SHADOW_DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/rice_management_shadow?schema=public"

# --- HTTP server -----------------------------------------------------------
PORT=3005
NODE_ENV=development

# --- CORS / cookies --------------------------------------------------------
# Comma-separated list of allowed origins (echoed back; '*' is NOT allowed
# because we use cookies + credentials).
# Local:
FRONTEND_URL=http://localhost:5173
# cPanel production (see .env.production.example):
# FRONTEND_URL=https://yousuf-kaihan.com

# Cookie behaviour. Defaults are:
#   prod  -> SameSite=strict, Secure=true   (best for same-domain deploys)
#   dev   -> SameSite=lax,    Secure=false  (works with localhost over HTTP)
# For cross-origin SaaS deploys (frontend on app.example.com, API on api.x.com)
# set: COOKIE_SAMESITE=none, COOKIE_SECURE=true (must be HTTPS).
# COOKIE_SAMESITE=strict
# COOKIE_SECURE=false
# COOKIE_DOMAIN=.yousuf-kaihan.com

# --- JWT secrets (generate with: openssl rand -base64 64) ------------------
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_ISSUER=yousuf-keyhan-mis
JWT_AUDIENCE=yousuf-keyhan-mis-clients

# --- Token lifetimes (milliseconds) ----------------------------------------
AUTH_ACCESS_TTL_MS=900000          # 15 minutes
AUTH_REFRESH_TTL_MS=1209600000     # 14 days
AUTH_CSRF_TTL_MS=1209600000        # match refresh
AUTH_RESET_TTL_MS=3600000          # 1 hour
AUTH_PERM_CACHE_TTL_MS=60000       # in-memory cache for user permissions

# --- Brute-force protection ------------------------------------------------
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MS=900000             # 15 minutes lockout after threshold

# --- Throttling (per-IP) ---------------------------------------------------
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120                 # default for protected endpoints
THROTTLE_LOGIN_LIMIT=10            # tighter for /auth/login

# --- Seed defaults (used by `npm run prisma:seed`) -------------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_PASSWORD=Admin@12345
