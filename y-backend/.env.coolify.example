#   NODE_ENV=production at Buildtime ON breaks npm ci → deployment fails.
#
# Do NOT add VITE_API_BASE_URL here (frontend service only).
# Frontend env: fontend/.env.production.example
#
# After first successful seed:
#   RUN_DB_SEED=false → redeploy
#
# Login: admin@example.com / Admin@12345.com
#
# =============================================================================

