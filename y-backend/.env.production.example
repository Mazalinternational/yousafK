# =============================================================================
# Production — BACKEND (cPanel / yousuf-kaihan.com)
# =============================================================================
#
# Copy to .env on the server (or set in cPanel → Node.js / Application Manager).
# Replace DATABASE_* and JWT_* with values from your cPanel host.
#
# Checklist
#   1. Frontend built with VITE_API_BASE_URL=https://yousuf-kaihan.com
#   2. FRONTEND_URL must match the browser origin exactly (HTTPS, no trailing slash)
#   3. COOKIE_SECURE=true (required for HTTPS)
#   4. Run migrations: npx prisma migrate deploy
#   5. After first seed: RUN_DB_SEED=false
#
# If API is on api.yousuf-kaihan.com instead of the apex domain, set:
#   COOKIE_DOMAIN=.yousuf-kaihan.com
#   COOKIE_SAMESITE=lax
# and rebuild the frontend with VITE_API_BASE_URL=https://api.yousuf-kaihan.com
#
# =============================================================================

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

PORT=3005
NODE_ENV=production

FRONTEND_URL=https://yousuf-kaihan.com
COOKIE_SAMESITE=lax
COOKIE_SECURE=true
# Same apex domain — leave unset, or use parent domain if you split api.* later:
# COOKIE_DOMAIN=.yousuf-kaihan.com

JWT_ACCESS_SECRET=replace-me-with-openssl-rand-base64-64
JWT_REFRESH_SECRET=replace-me-with-a-different-openssl-rand-base64-64
JWT_ISSUER=yousuf-keyhan-mis
JWT_AUDIENCE=yousuf-keyhan-mis-clients

AUTH_ACCESS_TTL_MS=900000
AUTH_REFRESH_TTL_MS=1209600000
AUTH_CSRF_TTL_MS=1209600000
AUTH_RESET_TTL_MS=3600000
AUTH_PERM_CACHE_TTL_MS=60000

AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MS=900000

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
THROTTLE_LOGIN_LIMIT=10

RUN_DB_SEED=false
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_PASSWORD=Admin@12345.com
