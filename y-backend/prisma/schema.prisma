// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// AUTH & RBAC
// -----------------------------------------------------------------------------
// User: the principal that authenticates. Soft-deletable.
// Role: a named bundle of permissions. The "admin" role is a system role that
//       implicitly grants every permission (wildcard short-circuit in the
//       PermissionsGuard).
// Permission: a (module, action) pair. The denormalized `key` ("module.action")
//             is what guards/decorators check against at runtime.
// UserRole / RolePermission: explicit join tables (Prisma needs them so we can
//                            attach metadata like assignedAt/assignedBy).
// Session: one per browser/device login. Owns a chain (family) of refresh
//          tokens. Revoking a session revokes every refresh token in it.
// RefreshToken: only the SHA-256 hash is stored. Rotated on every /auth/refresh.
//               Reuse of a revoked token marks `reuseDetectedAt` and revokes
//               the entire family (token-family invalidation).
// PasswordReset: hashed reset token. One-time use.
// AuditLog: append-only event log for security/admin events.
// =============================================================================

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  emailNormalized   String    @unique @map("email_normalized")
  name              String
  profilePicturePath String?  @map("profile_picture_path")
  passwordHash      String    @map("password_hash")
  isActive          Boolean   @default(true) @map("is_active")
  isLocked          Boolean   @default(false) @map("is_locked")
  failedLoginCount  Int       @default(0) @map("failed_login_count")
  lockedUntil       DateTime? @map("locked_until")
  lastLoginAt       DateTime? @map("last_login_at")
  lastLoginIp       String?   @map("last_login_ip")
  passwordChangedAt DateTime? @map("password_changed_at")
  deletedAt         DateTime? @map("deleted_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  createdById       String?   @map("created_by_id")

  roles          UserRole[]
  sessions       Session[]
  refreshTokens  RefreshToken[]
  passwordResets PasswordReset[]
  auditLogs      AuditLog[]      @relation("AuditLogActor")
  createdBy      User?           @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers   User[]          @relation("UserCreatedBy")

  @@index([emailNormalized])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id                       String    @id @default(cuid())
  name                     String    @unique
  slug                     String    @unique
  description              String?
  isSystem                 Boolean   @default(false) @map("is_system")
  /** Set when an admin saves permissions in the UI — blocks seed/sync from re-granting defaults. */
  permissionsCustomizedAt  DateTime? @map("permissions_customized_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  users       UserRole[]
  permissions RolePermission[]

  @@index([slug])
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  module      String
  action      String
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@unique([module, action])
  @@index([module])
  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  assignedBy String?  @map("assigned_by")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Session {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  device     String?
  lastUsedAt DateTime  @default(now()) @map("last_used_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("sessions")
}

model RefreshToken {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  sessionId       String    @map("session_id")
  tokenHash       String    @unique @map("token_hash")
  family          String
  expiresAt       DateTime  @map("expires_at")
  revokedAt       DateTime? @map("revoked_at")
  replacedById    String?   @map("replaced_by_id")
  reuseDetectedAt DateTime? @map("reuse_detected_at")
  ipAddress       String?   @map("ip_address")
  userAgent       String?   @map("user_agent")
  createdAt       DateTime  @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([family])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?  @map("user_id")
  actorEmail   String?  @map("actor_email")
  action       String
  module       String?
  resourceId   String?  @map("resource_id")
  resourceType String?  @map("resource_type")
  status       String
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  user User? @relation("AuditLogActor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([module])
  @@index([createdAt])
  @@index([status])
  @@map("audit_logs")
}

enum SeasonStatus {
  ACTIVE
  CLOSED
}

enum PaddyStockType {
  company
  farmer
}

enum PaddyPaymentType {
  paid
  partial_paid
  remaining
}

enum RiceSalePaymentChannel {
  cash
  saraf
}

enum ExpenseSettlementMode {
  direct
  vendor
}

enum RiceSaleChargeType {
  rice
  loading
  bags
}

enum StoreVarietySaleChargeType {
  sale
  loading
  bags
}

enum EnteringPaddyReceivedFrom {
  farmer
  seller
}

enum CustomerType {
  paddy_farmer
  paddy_seller
  rice_seller
  buyer
  process_production_buyer
  vendor
  debtor
}

enum EnteringPaddyWeightUnit {
  one_kg
  seven_kg
  ton
}

enum CustomerLedgerType {
  company_owned
  farmer_owned
  rice_owned
  process_production_owned
}

enum CustomerLedgerEntryType {
  company_receivable
  company_payment
  company_payment_on_behalf
  company_payment_received_on_behalf
  farmer_obligation
  farmer_rice_return
  buyer_payment
  buyer_payment_on_behalf
  buyer_payment_received_on_behalf
  buyer_debit
  buyer_credit
  seller_debit
  seller_credit
  vendor_expense
  vendor_payment
  debtor_disbursement
  debtor_repayment
}

enum StoreType {
  short_green
  regection
  broken_rice
  waste
}

enum StoreEntryStatus {
  stock
  sold
}

model Season {
  id                        String                     @id @default(cuid())
  name                      String
  code                      String?                    @unique
  startDate                 DateTime                   @map("start_date")
  endDate                   DateTime?                  @map("end_date")
  status                    SeasonStatus               @default(ACTIVE)
  closingNotes              String?                    @map("closing_notes")
  totalSales                Decimal                    @default(0) @map("total_sales") @db.Decimal(18, 2)
  totalExpenses             Decimal                    @default(0) @map("total_expenses") @db.Decimal(18, 2)
  totalPurchases            Decimal                    @default(0) @map("total_purchases") @db.Decimal(18, 2)
  closedAt                  DateTime?                  @map("closed_at")
  createdAt                 DateTime                   @default(now()) @map("created_at")
  updatedAt                 DateTime                   @updatedAt @map("updated_at")
  companyOwnedPaddyWarehouses CompanyOwnedPaddyWarehouse[]
  farmerOwnedPaddyWarehouses FarmerOwnedPaddyWarehouse[]
  riceWarehouses            RiceWarehouse[]
  enteringPaddies           EnteringPaddy[]
  customers                 Customer[]
  paddyProcesses            PaddyProcess[]
  storeEntries              StoreEntry[]
  storeVarietyStocks        StoreVarietyStock[]
  paddyVarietyStocks        PaddyVarietyStock[]
  riceVarietyStocks         RiceVarietyStock[]
  storeVarietySales         StoreVarietySale[]
  processRiceEntries        ProcessRiceEntry[]
  employees                 Employee[]
  jwalis                    Jwali[]
  sarafs                    Saraf[]
  investors                 Investor[]
  riceSales                 RiceSale[]
  riceCharities             RiceCharity[]
  cashTransactions          CashTransaction[]
  expenses                  Expense[]

  @@index([status])
  @@index([startDate])
  @@map("seasons")
}

model Jwali {
  id         BigInt   @id @default(autoincrement()) @db.BigInt
  name       String
  phoneNo    String   @map("phone_no")
  address    String
  notes      String?
  seasonId   String   @map("season_id")
  seasonName String   @map("season_name")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  season        Season             @relation(fields: [seasonId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  ledger        JwaliLedger?
  ledgerEntries JwaliLedgerEntry[]
  payments      JwaliPayment[]

  @@index([seasonId])
  @@index([name])
  @@index([phoneNo])
  @@map("jwalis")
}

model JwaliLedger {
  id        BigInt   @id @default(autoincrement()) @db.BigInt
  jwaliId   BigInt   @unique @map("jwali_id") @db.BigInt
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  jwali    Jwali              @relation(fields: [jwaliId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  entries  JwaliLedgerEntry[]
  payments JwaliPayment[]

  @@index([jwaliId])
  @@map("jwali_ledgers")
}

model JwaliLedgerEntry {
  id         BigInt   @id @default(autoincrement()) @db.BigInt
  ledgerId   BigInt   @map("ledger_id") @db.BigInt
  jwaliId    BigInt   @map("jwali_id") @db.BigInt
  bagCount   Int      @map("bag_count")
  ratePerBag Decimal  @map("rate_per_bag") @db.Decimal(18, 2)
  amount     Decimal  @db.Decimal(18, 2)
  currencyId String?  @map("currency_id")
  occurredAt DateTime @map("occurred_at")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  ledger   JwaliLedger @relation(fields: [ledgerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  jwali    Jwali       @relation(fields: [jwaliId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  currency Currency?   @relation("JwaliLedgerEntryCurrency", fields: [currencyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([ledgerId])
  @@index([jwaliId])
  @@index([occurredAt])
  @@index([currencyId])
  @@map("jwali_ledger_entries")
}

model JwaliPayment {
  id                    BigInt                 @id @default(autoincrement()) @db.BigInt
  ledgerId              BigInt                 @map("ledger_id") @db.BigInt
  jwaliId               BigInt                 @map("jwali_id") @db.BigInt
  amount                Decimal                @db.Decimal(18, 2)
  occurredAt            DateTime               @map("occurred_at")
  paymentChannel        RiceSalePaymentChannel @default(cash) @map("payment_channel")
  sarafId               BigInt?                @map("saraf_id") @db.BigInt
  currencyId            String?                @map("currency_id")
  sarafLedgerCurrencyId String?                @map("saraf_ledger_currency_id")
  notes                 String?
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  ledger              JwaliLedger       @relation(fields: [ledgerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  jwali               Jwali             @relation(fields: [jwaliId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  saraf               Saraf?            @relation(fields: [sarafId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  currency            Currency?         @relation("JwaliPaymentCurrency", fields: [currencyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sarafLedgerCurrency Currency?         @relation("JwaliPaymentSarafCurrency", fields: [sarafLedgerCurrencyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sarafLedgerEntry    SarafLedgerEntry?

  @@index([ledgerId])
  @@index([jwaliId])
  @@index([occurredAt])
  @@index([sarafId])
  @@index([paymentChannel])
  @@index([currencyId])
  @@map("jwali_payments")
}

model Saraf {
  id         BigInt   @id @default(autoincrement()) @db.BigInt
  name       String
  phoneNo    String   @map("phone_no")
  address    String
  notes      String?
  seasonId   String   @map("season_id")
  seasonName String   @map("season_name")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  season                   Season                     @relation(fields: [seasonId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  ledger                   SarafLedger?
  ledgerEntries            SarafLedgerEntry[]
  riceSales                RiceSale[]
  riceSalesLoading         RiceSale[]                   @relation("RiceSaleLoadingSaraf")
  riceSalesBags            RiceSale[]                   @relation("RiceSaleBagsSaraf")
  companyPaddyPurchases    CompanyOwnedPaddyWarehouse[]
  riceWarehousePurchases   RiceWarehouse[]
  employeeSalaryPayments   EmployeeLedgerEntry[]
  jwaliPayments            JwaliPayment[]
  storeEntries             StoreEntry[]
  storeVarietySales        StoreVarietySale[]
  storeVarietySalesLoading StoreVarietySale[]             @relation("StoreVarietySaleLoadingSaraf")
  storeVarietySalesBags    StoreVarietySale[]             @relation("StoreVarietySaleBagsSaraf")
  customerLedgerPayments   CustomerLedgerEntry[]
  expenses                 Expense[]

  @@index([seasonId])
  @@index([name])
  @@index([phoneNo])
  @@map("sarafs")
}

model Investor {
  id              BigInt   @id @default(autoincrement()) @db.BigInt
  name            String
  phoneNo         String   @map("phone_no")
  address         String
  sharePercentage Decimal  @map("share_percentage") @db.Decimal(5, 2)
  investedAmount  Decimal  @default(0) @map("invested_amount") @db.Decimal(18, 2)
  isActive        Boolean  @default(true) @map("is_active")
  notes           String?
  seasonId        String   @map("season_id")
  seasonName      String   @map("season_name")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([seasonId])
  @@index([name])
  @@index([phoneNo])
  @@index([isActive])
  @@map("investors")
}

model SarafLedger {
  id        BigInt   @id @default(autoincrement()) @db.BigInt
  sarafId   BigInt   @unique @map("saraf_id") @db.BigInt
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  saraf   Saraf              @relation(fields: [sarafId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  entries SarafLedgerEntry[]

  @@index([sarafId])
  @@map("saraf_ledgers")
}

model SarafLedgerEntry {
  id                             BigInt   @id @default(autoincrement()) @db.BigInt
  ledgerId                       BigInt   @map("ledger_id") @db.BigInt
  sarafId                        BigInt   @map("saraf_id") @db.BigInt
  currencyId                     String   @map("currency_id")
  amount                         Decimal  @db.Decimal(18, 2)
  occurredAt                     DateTime @map("occurred_at")
  notes                          String?
  riceSaleId                     BigInt?  @map("rice_sale_id") @db.BigInt
  riceSaleChargeType             RiceSaleChargeType? @map("rice_sale_charge_type")
  companyOwnedPaddyWarehouseId  BigInt?  @unique @map("company_owned_paddy_warehouse_id") @db.BigInt
  riceWarehouseId               BigInt?  @unique @map("rice_warehouse_id") @db.BigInt
  employeeLedgerEntryId         BigInt?  @unique @map("employee_ledger_entry_id") @db.BigInt
  jwaliPaymentId                BigInt?  @unique @map("jwali_payment_id") @db.BigInt
  storeEntryId                  BigInt?  @map("store_entry_id") @db.BigInt
  storeVarietySaleId            BigInt?  @map("store_variety_sale_id") @db.BigInt
  storeVarietySaleChargeType    StoreVarietySaleChargeType? @map("store_variety_sale_charge_type")
  expenseId                     BigInt?  @unique @map("expense_id") @db.BigInt
  customerLedgerEntryId         BigInt?  @unique @map("customer_ledger_entry_id") @db.BigInt
  createdAt                      DateTime @default(now()) @map("created_at")
  updatedAt                      DateTime @updatedAt @map("updated_at")

  ledger                       SarafLedger                 @relation(fields: [ledgerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  saraf                        Saraf                       @relation(fields: [sarafId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  currency                     Currency                    @relation(fields: [currencyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  riceSale                     RiceSale?                   @relation("RiceSaleSarafEntries", fields: [riceSaleId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  companyOwnedPaddyWarehouse   CompanyOwnedPaddyWarehouse? @relation(fields: [companyOwnedPaddyWarehouseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  riceWarehouse                RiceWarehouse?              @relation(fields: [riceWarehouseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  employeeLedgerEntry          EmployeeLedgerEntry?        @relation(fields: [employeeLedgerEntryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  jwaliPayment                 JwaliPayment?               @relation(fields: [jwaliPaymentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  storeEntry                   StoreEntry?                 @relation(fields: [storeEntryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  storeVarietySale             StoreVarietySale?           @relation("StoreVarietySaleSarafEntries", fields: [storeVarietySaleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  customerLedgerEntry          CustomerLedgerEntry?        @relation(fields: [customerLedgerEntryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  expense                      Expense?                    @relation(fields: [expenseId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([ledgerId])
  @@index([sarafId])
  @@index([currencyId])
  @@index([occurredAt])
  @@index([riceSaleId])
  @@index([companyOwnedPaddyWarehouseId])
  @@index([riceWarehouseId])
  @@index([employeeLedgerEntryId])
  @@index([jwaliPaymentId])
  @@index([storeEntryId])
  @@index([expenseId])
  @@index([customerLedgerEntryId])
  @@map("saraf_ledger_entries")
}

model Employee {
  id            BigInt   @id @default(autoincrement()) @db.BigInt
  employeeNo    String   @unique @map("employee_no")
  name          String
  position      String
  phoneNo       String   @map("phone_no")
  address       String
  joinDate      DateTime @map("join_date")
  monthlySalary Decimal  @map("monthly_salary") @db.Decimal(18, 2)
  status        String
  inactiveDate  DateTime? @map("inactive_date")
  notes         String?
  seasonId      String   @map("season_id")
  seasonName    String   @map("season_name")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  season        Season               @relation(fields: [seasonId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  ledger        EmployeeLedger?
  ledgerEntries EmployeeLedgerEntry[]

  @@index([seasonId])
  @@index([employeeNo])
  @@index([name])
  @@index([status])
  @@map("employees")
}

model EmployeeLedger {
  id         BigInt   @id @default(autoincrement()) @db.BigInt
  employeeId BigInt   @unique @map("employee_id") @db.BigInt
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  employee Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  entries   EmployeeLedgerEntry[]

  @@index([employeeId])
  @@map("employee_ledgers")
}

model EmployeeLedgerEntry {
  id                    BigInt                 @id @default(autoincrement()) @db.BigInt
  ledgerId             BigInt                 @map("ledger_id") @db.BigInt
  employeeId           BigInt                 @map("employee_id") @db.BigInt
  entryType            String                 @map("entry_type")
  amount               Decimal                @db.Decimal(18, 2)
  salaryMonth          DateTime               @map("salary_month")
  occurredAt           DateTime               @map("occurred_at")
  isAdvance            Boolean                @default(false) @map("is_advance")
  paymentChannel       RiceSalePaymentChannel @default(cash) @map("payment_channel")
  sarafId              BigInt?                @map("saraf_id") @db.BigInt
  sarafLedgerCurrencyId String?               @map("saraf_ledger_currency_id")
  notes                String?
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")

  ledger              EmployeeLedger    @relation(fields: [ledgerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  employee            Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  saraf               Saraf?            @relation(fields: [sarafId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sarafLedgerCurrency Currency?         @relation("EmployeeSalarySarafCurrency", fields: [sarafLedgerCurrencyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sarafLedgerEntry    SarafLedgerEntry?
  cashTransaction     CashTransaction?

  @@index([ledgerId])
  @@index([employeeId])
  @@index([entryType])
  @@index([salaryMonth])
  @@index([occurredAt])
  @@index([sarafId])
  @@index([paymentChannel])
  @@map("employee_ledger_entries")
}

model CompanyOwnedPaddyWarehouse {
  id                    BigInt                 @id @default(autoincrement()) @db.BigInt
  enteringPaddyId       BigInt?                @unique @map("entering_paddy_id") @db.BigInt
  billNo                String                 @map("bill_no")
  enteringBillNo        String?                @map("entering_bill_no")
  stockType             PaddyStockType         @default(company) @map("stock_type")
  variety               String
  quantity              Decimal                @db.Decimal(18, 2)
  unit                  String
  ownerName             String                 @map("owner_name")
  rate                  Decimal                @db.Decimal(18, 2)
  totalAmount           Decimal                @map("total_amount") @db.Decimal(18, 2)
  paymentType           PaddyPaymentType       @default(remaining) @map("payment_type")
  paidAmount            Decimal                @default(0) @map("paid_amount") @db.Decimal(18, 2)
  remainingAmount       Decimal                @map("remaining_amount") @db.Decimal(18, 2)
  paymentChannel        RiceSalePaymentChannel @default(cash) @map("payment_channel")
  sarafId               BigInt?                @map("saraf_id") @db.BigInt
