model CustomerLedgerEntry {
  id                            BigInt                  @id @default(autoincrement()) @db.BigInt
  ledgerId                      BigInt                  @map("ledger_id") @db.BigInt
  customerId                    BigInt                  @map("customer_id") @db.BigInt
  entryType                     CustomerLedgerEntryType @map("entry_type")
  sourceCompanyPaddyWarehouseId BigInt?                 @unique @map("source_company_paddy_warehouse_id") @db.BigInt
  sourceFarmerPaddyWarehouseId  BigInt?                 @unique @map("source_farmer_paddy_warehouse_id") @db.BigInt
  sourceRiceWarehouseId         BigInt?                 @unique @map("source_rice_warehouse_id") @db.BigInt
  amount                        Decimal?                @db.Decimal(18, 2)
  paymentType                   String?                 @map("payment_type")
  paidAmount                    Decimal?                @map("paid_amount") @db.Decimal(18, 2)
  remainingAmount               Decimal?                @map("remaining_amount") @db.Decimal(18, 2)
  paymentChannel                RiceSalePaymentChannel? @map("payment_channel")
  sarafId                       BigInt?                 @map("saraf_id") @db.BigInt
  currencyId                    String?                 @map("currency_id")
  paddyQuantity                 Decimal?                @map("paddy_quantity") @db.Decimal(18, 2)
  riceQuantity                  Decimal?                @map("rice_quantity") @db.Decimal(18, 2)
  riceVariety                   String?                 @map("rice_variety")
  unit                          String?
  occurredAt                    DateTime                @map("occurred_at")
  scheduledFor                  DateTime?               @map("scheduled_for")
  riceStockFulfilledAt          DateTime?               @map("rice_stock_fulfilled_at")
  notes                         String?
  counterpartyCustomerId        BigInt?                 @map("counterparty_customer_id") @db.BigInt
  linkedLedgerEntryId           BigInt?                 @unique @map("linked_ledger_entry_id") @db.BigInt
  sourceExpenseId               BigInt?                 @map("source_expense_id") @db.BigInt
  createdAt                     DateTime                @default(now()) @map("created_at")
  updatedAt                     DateTime                @updatedAt @map("updated_at")

  ledger            CustomerLedger     @relation(fields: [ledgerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  customer          Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  counterpartyCustomer Customer?       @relation("LedgerEntryCounterparty", fields: [counterpartyCustomerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  linkedLedgerEntry CustomerLedgerEntry? @relation("LedgerEntryPair", fields: [linkedLedgerEntryId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  inverseLinkedEntry CustomerLedgerEntry? @relation("LedgerEntryPair")
  saraf             Saraf?             @relation(fields: [sarafId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  currency          Currency?          @relation(fields: [currencyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sarafLedgerEntry SarafLedgerEntry?
  cashTransaction  CashTransaction?
  sourceRiceWarehouse RiceWarehouse? @relation(fields: [sourceRiceWarehouseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sourceExpense     Expense?       @relation(fields: [sourceExpenseId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([ledgerId])
  @@index([customerId])
  @@index([sourceRiceWarehouseId])
  @@index([sourceExpenseId])
  @@index([entryType])
  @@index([occurredAt])
  @@index([scheduledFor])
  @@index([riceStockFulfilledAt])
  @@index([counterpartyCustomerId])
  @@index([linkedLedgerEntryId])
  @@map("customer_ledger_entries")
}

model ExpenseCategory {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  expenses Expense[]

  @@index([isActive])
  @@map("expense_categories")
}

model Expense {
  id              BigInt                  @id @default(autoincrement()) @db.BigInt
  billNo          String                  @unique @map("bill_no")
  date            DateTime                @map("date") @db.Date
  categoryId      String                  @map("category_id")
  title           String
  amount          Decimal                 @db.Decimal(18, 2)
  notes           String?
  seasonId        String                  @map("season_id")
  seasonName      String                  @map("season_name")
  currencyId      String                  @map("currency_id")
  settlementMode  ExpenseSettlementMode   @default(direct) @map("settlement_mode")
  vendorId        BigInt?                 @map("vendor_id") @db.BigInt
  paymentType     String?                 @map("payment_type")
  paidAmount      Decimal?                @map("paid_amount") @db.Decimal(18, 2)
  remainingAmount Decimal?                @map("remaining_amount") @db.Decimal(18, 2)
  paymentChannel  RiceSalePaymentChannel  @default(cash) @map("payment_channel")
  sarafId         BigInt?                 @map("saraf_id") @db.BigInt
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  category           ExpenseCategory        @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  season             Season                 @relation(fields: [seasonId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  currency           Currency               @relation(fields: [currencyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  vendor             Customer?              @relation("ExpenseVendor", fields: [vendorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  saraf              Saraf?                 @relation(fields: [sarafId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  cashTransaction    CashTransaction?
  sarafLedgerEntry   SarafLedgerEntry?
  vendorLedgerEntries CustomerLedgerEntry[]

  @@index([seasonId])
  @@index([categoryId])
  @@index([date])
  @@index([currencyId])
  @@index([settlementMode])
  @@index([vendorId])
  @@index([paymentChannel])
  @@index([sarafId])
  @@map("expenses")
}

model Currency {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  sarafLedgerEntries           SarafLedgerEntry[]
  riceSalesSarafSettlement     RiceSale[]                   @relation("RiceSaleSarafCurrency")
  riceSalesLoadingCurrency     RiceSale[]                   @relation("RiceSaleLoadingCurrency")
  riceSalesBagsCurrency        RiceSale[]                   @relation("RiceSaleBagsCurrency")
  companyPaddySarafSettlements CompanyOwnedPaddyWarehouse[] @relation("CompanyPaddySarafCurrency")
  riceWarehouseSettlements     RiceWarehouse[]              @relation("RiceWarehouseSarafCurrency")
  employeeSalarySarafSettlements EmployeeLedgerEntry[]      @relation("EmployeeSalarySarafCurrency")
  jwaliLedgerEntries             JwaliLedgerEntry[]         @relation("JwaliLedgerEntryCurrency")
  jwaliPayments                  JwaliPayment[]             @relation("JwaliPaymentCurrency")
  jwaliPaymentSarafSettlements   JwaliPayment[]             @relation("JwaliPaymentSarafCurrency")
  storeSalesSarafSettlements   StoreEntry[]                 @relation("StoreSaleSarafCurrency")
  storeVarietySalesSarafSettlements StoreVarietySale[]      @relation("StoreVarietySaleSarafCurrency")
  storeVarietySalesLoadingCurrency  StoreVarietySale[]      @relation("StoreVarietySaleLoadingCurrency")
  storeVarietySalesBagsCurrency     StoreVarietySale[]      @relation("StoreVarietySaleBagsCurrency")
  cashTransactions                  CashTransaction[]
  customerLedgerEntries           CustomerLedgerEntry[]
  expenses                          Expense[]

  @@index([isActive])
  @@map("currencies")
}

enum CashTransactionDirection {
  in
  out

  @@map("cash_transaction_direction")
}

model CashTransaction {
  id         String                   @id @default(cuid())
  currencyId String                   @map("currency_id")
  direction  CashTransactionDirection
  amount     Decimal                  @db.Decimal(18, 2)
  occurredAt DateTime                 @map("occurred_at")
  notes      String?
  seasonId   String?                  @map("season_id")
  seasonName String?                  @map("season_name")
  expenseId                       BigInt?  @unique @map("expense_id") @db.BigInt
  customerLedgerEntryId           BigInt?  @unique @map("customer_ledger_entry_id") @db.BigInt
  employeeLedgerEntryId           BigInt?  @unique @map("employee_ledger_entry_id") @db.BigInt
  riceWarehouseId                 BigInt?  @unique @map("rice_warehouse_id") @db.BigInt
  companyOwnedPaddyWarehouseId    BigInt?  @unique @map("company_owned_paddy_warehouse_id") @db.BigInt
  riceSaleId                      BigInt?  @map("rice_sale_id") @db.BigInt
  riceSaleChargeType              RiceSaleChargeType? @map("rice_sale_charge_type")
  storeVarietySaleId              BigInt?  @map("store_variety_sale_id") @db.BigInt
  storeVarietySaleChargeType      StoreVarietySaleChargeType? @map("store_variety_sale_charge_type")
  createdAt                       DateTime @default(now()) @map("created_at")
  updatedAt                       DateTime @updatedAt @map("updated_at")

  currency                     Currency                    @relation(fields: [currencyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  season                       Season?                     @relation(fields: [seasonId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  customerLedgerEntry          CustomerLedgerEntry?        @relation(fields: [customerLedgerEntryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  employeeLedgerEntry          EmployeeLedgerEntry?        @relation(fields: [employeeLedgerEntryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  riceWarehouse                RiceWarehouse?              @relation(fields: [riceWarehouseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  companyOwnedPaddyWarehouse   CompanyOwnedPaddyWarehouse? @relation(fields: [companyOwnedPaddyWarehouseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  riceSale                     RiceSale?                   @relation("RiceSaleCashTransactions", fields: [riceSaleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  storeVarietySale             StoreVarietySale?           @relation("StoreVarietySaleCashTransactions", fields: [storeVarietySaleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  expense                      Expense?                    @relation(fields: [expenseId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([currencyId])
  @@index([seasonId])
  @@index([occurredAt])
  @@index([expenseId])
  @@index([customerLedgerEntryId])
  @@index([employeeLedgerEntryId])
  @@index([riceWarehouseId])
  @@index([companyOwnedPaddyWarehouseId])
  @@index([riceSaleId])
  @@index([storeVarietySaleId])
  @@map("cash_transactions")
}

enum VarietyKind {
  RICE
  PADDY
  PROCESS_PRODUCTION

  @@map("variety_kind")
}

model Variety {
  id        String       @id @default(cuid())
  kind      VarietyKind
  code      String
  name      String
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@unique([kind, code])
  @@index([kind])
  @@index([isActive])
  @@map("varieties")
}
