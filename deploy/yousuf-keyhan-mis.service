[Unit]
Description=Yousuf Keyhan MIS (NestJS)
After=network.target postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/yousuf-keyhan-mis/backend
EnvironmentFile=/var/www/yousuf-keyhan-mis/backend/.env
ExecStart=/usr/bin/node dist/main.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
