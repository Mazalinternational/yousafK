# Production — FRONTEND (cPanel / yousuf-kaihan.com)
# =============================================================================
#
# Vite embeds VITE_* at BUILD time. Set this before `npm run build`, then
# upload the contents of dist/ to public_html (or your cPanel document root).
#
# Site: https://yousuf-kaihan.com
# API:  https://api.yousuf-kaihan.com
#
# Backend must have:
#   FRONTEND_URL=https://yousuf-kaihan.com
#   COOKIE_DOMAIN=.yousuf-kaihan.com
#   COOKIE_SECURE=true
#
# =============================================================================

VITE_API_BASE_URL=https://api.yousuf-kaihan.com
