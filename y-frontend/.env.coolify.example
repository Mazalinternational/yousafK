# =============================================================================
# Coolify — FRONTEND service (copy/paste into Environment Variables)
# =============================================================================
#
# Coolify → FRONTEND service → Environment
#   • General → Ports Exposes = 3000  (do NOT set PORT env var here)
#   • Domain: frontend.49.13.62.120.sslip.io
#   • Redeploy after changes (Vite bakes VITE_* at build time)
#
# Do NOT paste backend variables (DATABASE_URL, JWT_*, PORT, FRONTEND_URL, etc.).
# Backend env: backend/.env.coolify.example
#
# Buildtime settings (critical):
#   VITE_API_BASE_URL     → Buildtime YES
#   NIXPACKS_SPA_OUTPUT_DIR → Buildtime NO
#
# Verify build log contains:
#   --env 'VITE_API_BASE_URL=http://backend.49.13.62.120.sslip.io'
#
# =============================================================================

VITE_API_BASE_URL=http://backend.49.13.62.120.sslip.io
NIXPACKS_SPA_OUTPUT_DIR=dist
